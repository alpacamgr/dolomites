---
// Development harness for the globe engine. Not linked from the site.
// Wiring lives in src/lib/globe/dev/panel.ts (strictly typechecked).
// URL parameters: ?data=sample&t=240&lat=0&lon=180&dist=2.6&size=2k
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Globe engine - dev</title>
    <link rel="icon" href="data:," />
    <style is:global>
      html, body { margin: 0; height: 100%; background: #03050b; color: #e6ecff; font: 13px/1.4 system-ui, sans-serif; overflow: hidden; }
      #stage { position: fixed; inset: 0; }
      #panel {
        position: fixed; top: 12px; left: 12px; z-index: 10; width: 300px; max-height: calc(100vh - 24px); overflow: auto;
        background: rgba(6, 10, 24, 0.74); backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 10px; padding: 14px 16px;
      }
      #panel h1 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 10px; color: #a3b3d7; font-weight: 600; }
      .row { display: flex; align-items: center; gap: 8px; margin: 8px 0; }
      .row label { flex: 1; color: #b8c4e0; }
      button { background: rgba(255, 255, 255, 0.06); color: #e6ecff; border: 1px solid rgba(255, 255, 255, 0.14); padding: 5px 9px; border-radius: 6px; cursor: pointer; font: inherit; }
      button:hover { background: rgba(255, 255, 255, 0.12); }
      input[type='range'] { width: 100%; }
      .time-row { display: flex; justify-content: space-between; align-items: center; }
      .time-value { font-variant-numeric: tabular-nums; color: #ffd24a; }
      .presets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
      .toggles { display: grid; grid-template-columns: 1fr 1fr; gap: 5px 12px; }
      .toggles label { display: flex; gap: 6px; align-items: center; color: #b8c4e0; }
      .divider { border-top: 1px solid rgba(255, 255, 255, 0.08); margin: 10px 0; }
      .small { font-size: 11px; color: #a3b3d7; }
      #attributions { font-size: 11px; color: #8592b0; margin-top: 8px; line-height: 1.45; }
      #attributions div { margin-bottom: 4px; }
      #scrub-result { font-size: 11px; color: #ffd24a; margin-top: 4px; font-variant-numeric: tabular-nums; }
      #fps { position: fixed; top: 12px; right: 12px; z-index: 10; background: rgba(6, 10, 24, 0.74); padding: 6px 10px; border-radius: 8px; font-variant-numeric: tabular-nums; font-size: 12px; }
      #loading { position: fixed; bottom: 12px; right: 12px; z-index: 10; background: rgba(6, 10, 24, 0.74); padding: 6px 10px; border-radius: 8px; color: #ffd24a; display: none; }
      #loading.on { display: block; }
      select { background: #0d1226; color: #e6ecff; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 6px; padding: 4px 6px; font: inherit; }
    </style>
  </head>
  <body>
    <div id="stage"></div>
    <div id="panel">
      <h1>Globe engine (dev)</h1>
      <div class="time-row">
        <label for="time">Time</label>
        <span class="time-value" id="time-value">0.0 Ma</span>
      </div>
      <input type="range" id="time" min="0" max="300" step="0.1" value="0" />
      <div class="row">
        <button id="play">Play</button>
        <button id="scrub">Scrub test 300 to 0 Ma (10 s)</button>
      </div>
      <div id="scrub-result"></div>
      <div class="divider"></div>
      <div class="small">Camera presets</div>
      <div class="presets">
        <button data-preset="europe">Europe</button>
        <button data-preset="pangea">Pangea</button>
        <button data-preset="pacific">Pacific</button>
        <button data-preset="antimeridian">Lon 180</button>
        <button data-preset="southpole">South pole</button>
      </div>
      <div class="divider"></div>
      <div class="row">
        <label for="size">Texture size</label>
        <select id="size"><option value="2k">2k</option><option value="4k">4k</option></select>
      </div>
      <div class="row">
        <label for="data">Data</label>
        <select id="data">
          <option value="/data">real /data</option>
          <option value="/data/_sample">SAMPLE /data/_sample</option>
        </select>
      </div>
      <div class="divider"></div>
      <div class="small">Layers</div>
      <div class="toggles">
        <label title="Continental crust outline, PALEOMAP"><input type="checkbox" data-toggle="showLandmass" /> crust outline</label>
        <label title="Tectonic blocks, PALEOMAP"><input type="checkbox" data-toggle="showBlocks" /> tectonic blocks</label>
        <label><input type="checkbox" data-toggle="showCoastlines" /> coastlines</label>
        <label><input type="checkbox" data-toggle="showBoundaries" checked /> boundaries</label>
        <label><input type="checkbox" data-toggle="showMarker" checked /> Dolomites</label>
        <label><input type="checkbox" data-toggle="showTrail" checked /> trail</label>
        <label><input type="checkbox" data-toggle="atmosphere" checked /> atmosphere</label>
        <label><input type="checkbox" data-toggle="normals" checked /> normal maps</label>
        <label><input type="checkbox" data-toggle="stars" checked /> stars</label>
        <label><input type="checkbox" data-toggle="locked" /> lock input</label>
      </div>
      <div class="divider"></div>
      <div class="small" id="loading-inline">Loading...</div>
      <div id="attributions"></div>
    </div>
    <div id="fps">-- fps</div>
    <div id="loading">loading</div>
    <script>
      import '@/lib/globe/dev/panel';
    </script>
  </body>
</html>
