---
/**
 * Static 404 page in all three site languages (the URL alone does not tell which one the reader
 * wanted), with links to each language's story. Served by the host's not-found handling.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOCALES, loadUi } from '@/lib/i18n';

const strings = Object.fromEntries(LOCALES.map((l) => [l, loadUi(l)])) as Record<(typeof LOCALES)[number], Record<string, string>>;
const en = strings.en;
---
<BaseLayout locale="en" title={`${en['not_found.title']} · ${en['site.title']}`} alternates={false} robots="noindex">
  <div class="site">
    <header class="masthead">
      <div class="brand">
        <span class="brand-title">{en['site.title']}</span>
      </div>
    </header>
    <main class="not-found">
      {LOCALES.map((l) => (
        <section lang={l}>
          <h1>{strings[l]['not_found.title']}</h1>
          <p>{strings[l]['not_found.text']}</p>
          <p><a href={`/${l}/`} hreflang={l}>{strings[l]['not_found.link']}</a></p>
        </section>
      ))}
    </main>
  </div>
</BaseLayout>
